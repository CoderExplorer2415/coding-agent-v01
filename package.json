{
  "name": "coding-agent-v01",
  "version": "0.1.0",
  "description": "AI coding assistant with model-agnostic support and dual-mode agents",
  "main": "dist/backend/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:backend\"",
    "dev:electron": "electron .",
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "build:frontend": "vite build",
    "build:backend": "tsc",
    "build:electron": "tsc src/main.ts --outDir dist --declaration",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.0",
    "anthropic": "^0.10.0",
    "google-generativeai": "^0.3.0",
    "lucide-react": "^0.292.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "tsx": "^3.13.0",
    "electron": "^26.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0"
  }
}
